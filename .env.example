# Use bundled mock data instead of the Go API (true until the backend is ready).
VITE_USE_MOCK=true

# Go/Gin API base URL, e.g. https://api.clientdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Public R2 bucket custom domain. Relative asset keys from the API are resolved against this.
VITE_ASSET_BASE_URL=https://assets.clientdomain.com

# "hash" for the Electron/file:// kiosk build, "browser" for web hosting.
VITE_ROUTER=browser

VITE_BRAND_NAME=Your Brand Realty

# Showroom only: PIN that reveals prices in the UI. Real price protection is enforced by the API.
VITE_STAFF_PIN=2468

# Return to the home screen after this many seconds without interaction (0 disables).
VITE_IDLE_RESET_SECONDS=180
